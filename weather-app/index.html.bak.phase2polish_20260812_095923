radarSliderControl.addTo(map);
setTimeout(() => {
  const slider = document.getElementById('radar-time-slider');
  const display = document.getElementById('radar-time-display');
  const rewind = document.getElementById('radar-rewind');
  const forward = document.getElementById('radar-forward');
  if (slider) {
    const updateSlider = () => {
      const max = radarFrames[0]?.times?.length - 1 || 0;
      slider.max = Math.max(max, 0);
      slider.value = radarCurrentFrame;
      if (radarFrames[0]?.times[radarCurrentFrame]) {
        const dt = new Date(radarFrames[0].times[radarCurrentFrame]);
        display.textContent = dt.toLocaleString('th-TH', { hour: '2-digit', minute: '2-digit', day: 'numeric', month: 'short' });
      }
    };
    updateSlider();
    slider.addEventListener('input', (e) => {
      radarCurrentFrame = parseInt(e.target.value);
      updateRadarFrame();
      updateSlider();
    });
    if (rewind) rewind.addEventListener('click', () => {
      if (radarCurrentFrame > 0) { radarCurrentFrame--; updateSlider(); slider.value = radarCurrentFrame; updateRadarFrame(); }
    });
    if (forward) forward.addEventListener('click', () => {
      const max = radarFrames[0]?.times?.length - 1 || 0;
      if (radarCurrentFrame < max) { radarCurrentFrame++; updateSlider(); slider.value = radarCurrentFrame; updateRadarFrame(); }
    });
  }
}, 1000);



