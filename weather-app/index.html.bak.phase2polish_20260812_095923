<script>
// ===== Per-Zone Forecast Panel (5 zones) =====
const WEATHER_CODES = {0:'☀️',1:'🌤️',2:'⛅',3:'☁️',45:'🌫️',48:'🌫️',51:'🌦️',53:'🌦️',55:'🌦️',61:'🌧️',63:'🌧️',65:'🌧️',71:'🌨️',73:'🌨️',75:'🌨️',80:'🌦️',81:'🌧️',82:'⛈️',95:'⛈️',96:'⛈️',99:'⛈️'};

async function loadZoneForecasts() {
  const grid = document.getElementById('zone-forecast-grid');
  const timeEl = document.getElementById('zone-forecast-time');
  if (!grid || !zones) return;

  // Check cache (10 min)
  const cacheKey = 'zone-forecast-v1';
  const cached = localStorage.getItem(cacheKey);
  if (cached) {
    try {
      const {ts, html} = JSON.parse(cached);
      if (Date.now() - ts < 600000) {
        grid.innerHTML = html;
        if (timeEl) timeEl.textContent = new Date(ts).toLocaleTimeString('th-TH', {hour:'2-digit', minute:'2-digit'});
        return;
      }
    } catch(e) {}
  }

  // Fetch all 5 zones in parallel
  const results = await Promise.all(zones.map(async z => {
    try {
      const url = `https://api.open-meteo.com/v1/forecast?latitude=${z.lat}&longitude=${z.lng}&current=temperature_2m,precipitation,weathercode&daily=temperature_2m_max,temperature_2m_min,precipitation_sum,weathercode&timezone=Asia/Bangkok&forecast_days=2`;
      const r = await fetch(url);
      const d = await r.json();
      const c = d.current || {};
      const t0 = d.daily;
      return {
        zone: z,
        temp: c.temperature_2m,
        rain: c.precipitation || 0,
        code: c.weathercode || 0,
        max: t0.temperature_2m_max[0],
        min: t0.temperature_2m_min[0],
        rainToday: t0.precipitation_sum[0],
        rainTmrw: t0.precipitation_sum[1],
        codeTmrw: t0.weathercode[1]
      };
    } catch(e) {
      return {zone: z, error: true};
    }
  }));

  // Render cards
  grid.innerHTML = results.map(r => {
    if (r.error) {
      return `<div class="bg-red-50 p-3 rounded-lg text-xs text-red-600 text-center">⚠️ ${r.zone.name}<br>โหลดไม่สำเร็จ</div>`;
    }
    const emoji = WEATHER_CODES[r.code] || '🌡️';
    const emojiTmrw = WEATHER_CODES[r.codeTmrw] || '🌡️';
    // Rain level color
    let bg = 'bg-emerald-50', border = 'border-emerald-200', text = 'text-emerald-700';
    if (r.rainToday > 5) { bg = 'bg-rose-50'; border = 'border-rose-200'; text = 'text-rose-700'; }
    else if (r.rainToday > 0) { bg = 'bg-amber-50'; border = 'border-amber-200'; text = 'text-amber-700'; }
    return `
      <div class="${bg} border ${border} rounded-lg p-3 hover:shadow-md transition-shadow cursor-pointer" onclick="map.flyTo([${r.zone.lat}, ${r.zone.lng}], 11, {duration:1})">
        <div class="flex items-center justify-between mb-2">
          <div class="text-xs font-semibold navy truncate">${r.zone.emoji} ${r.zone.name}</div>
          <div class="text-2xl">${emoji}</div>
        </div>
        <div class="text-2xl font-bold navy font-mono">${r.temp?.toFixed(1) || '—'}<span class="text-xs text-slate-500">°C</span></div>
        <div class="text-[10px] text-slate-500 mt-1">H ${r.max?.toFixed(0) || '—'}° / L ${r.min?.toFixed(0) || '—'}°</div>
        <div class="text-[10px] ${text} font-semibold mt-1 pt-1 border-t ${border}">
          🌧️ วันนี้ ${r.rainToday?.toFixed(1) || '0.0'} มม.
        </div>
        <div class="text-[10px] text-slate-500 mt-1 flex items-center gap-1">
          ${emojiTmrw} พรุ่งนี้ ${r.rainTmrw?.toFixed(1) || '0.0'} มม.
        </div>
      </div>`;
  }).join('');

  // Save to cache + update time
  const now = Date.now();
  if (timeEl) timeEl.textContent = new Date(now).toLocaleTimeString('th-TH', {hour:'2-digit', minute:'2-digit'});
  try { localStorage.setItem(cacheKey, JSON.stringify({ts: now, html: grid.innerHTML})); } catch(e) {}
}

// Load zone forecasts after page ready
loadZoneForecasts();
</script>

<script>
// ===== 📢 Advisory Cards (SKA pattern: กล่องสี + สถานะ + ทำอะไร) =====
async function loadAdvisories() {
  const lat = 7.620, lng = 100.075;
  try {
