<script>
// 🛰️ A1: Satellite + OSM toggle
const map = L.map('map', { zoomControl: true, attributionControl: true }).setView([7.6, 100.15], 9);
const satelliteLayer = L.tileLayer('https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}', {
  attribution: '🛰️ Esri Satellite',
  maxZoom: 18
});
const osmLayer = L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
  attribution: '© OpenStreetMap',
  maxZoom: 18
});
satelliteLayer.addTo(map);
L.control.layers(
  { '🛰️ ดาวเทียม': satelliteLayer, '🗺️ แผนที่': osmLayer },
  null,
  { position: 'topright', collapsed: false }
).addTo(map);

// 🌧️ B1+B2: Open-Meteo precipitation radar (ดึงแยกตามโซน)
let radarFrames = [];      // [{ zone, times[], precip[] }, ...] — 1 entry/zone
let radarCurrentFrame = 0;
let radarPlaying = false;
let radarAnimInterval = null;
let rainLayerGroup = null;
let rainEnabled = true;

// ดึงข้อมูลฝนรายโซน (5 จุดวิจัยหลัก)
async function loadRadarData() {
  try {
    radarFrames = [];
    // ดึงพร้อมกันทุกโซน เร็วขึ้น
    const fetches = zones.map(async (zone) => {
      try {
        const url = `https://api.open-meteo.com/v1/forecast?latitude=${zone.lat}&longitude=${zone.lng}&hourly=precipitation&forecast_days=2&timezone=Asia/Bangkok`;
        const r = await fetch(url);
        const data = await r.json();
        return {
          zone,
          times: data.hourly?.time || [],
          precip: data.hourly?.precipitation || []
        };
      } catch (e) {
        return { zone, times: [], precip: [] };
      }
    });
    radarFrames = await Promise.all(fetches);

    // ตั้งเวลาเริ่มต้น = "ตอนนี้" (index สุดท้าย)
    if (radarFrames[0]?.times?.length > 0) {
      radarCurrentFrame = radarFrames[0].times.length - 1;
      updateRadarFrame();
    }
  } catch (e) {
    console.log('Open-Meteo radar failed:', e.message);
  }
}

// แสดงฝนเป็นวงกลมที่ตำแหน่งแต่ละโซน
function updateRadarFrame() {
  if (rainLayerGroup) {
    map.removeLayer(rainLayerGroup);
    rainLayerGroup = null;
  }
  if (!radarEnabled || radarFrames.length === 0) return;

  rainLayerGroup = L.layerGroup();
  let hasAnyRain = false;

  radarFrames.forEach(f => {
    if (!f.times.length) return;
    const precip = f.precip[radarCurrentFrame] || 0;
    const zoneName = f.zone.name;

    if (precip > 0.1) {
      hasAnyRain = true;
      const intensity = Math.min(precip / 10, 1);
      const radius = 12000 + intensity * 28000; // 12-40 km
      const color = precip > 5 ? '#dc2626'   // ฝนหนัก
                  : precip > 2 ? '#f59e0b'   // ฝนปานกลาง
                                : '#10b981'; // ฝนเบา
      L.circle([f.zone.lat, f.zone.lng], {
        radius, color, fillColor: color,
        fillOpacity: 0.35 + intensity * 0.4, weight: 2
      }).addTo(rainLayerGroup);

      // Label ปริมาณฝน
      L.marker([f.zone.lat, f.zone.lng], {
        icon: L.divIcon({
          className: 'rain-label',
          html: '<div style="background:' + color + ';color:white;padding:2px 6px;border-radius:10px;font-size:10px;font-weight:700;white-space:nowrap;box-shadow:0 1px 3px rgba(0,0,0,.3);">' + precip.toFixed(1) + 'mm</div>',
          iconSize: [40, 16],
          iconAnchor: [20, 8]
        })
      }).addTo(rainLayerGroup);
    } else {
      // marker บาง ๆ ให้รู้ว่าตรวจฝนอยู่ (เห็นแม้ไม่มีฝน)
      L.marker([f.zone.lat, f.zone.lng], {
        icon: L.divIcon({
          className: 'rain-label',
          html: '<div style="background:white;color:#64748b;padding:2px 6px;border-radius:10px;font-size:9px;font-weight:600;white-space:nowrap;border:1px dashed #94a3b8;">' + zoneName + ' • 0mm</div>',
          iconSize: [80, 16],
          iconAnchor: [40, 8]
        })
      }).addTo(rainLayerGroup);
    }
  });
  rainLayerGroup.addTo(map);

  // อัปเดต label เวลา
  const label = document.getElementById('radar-time-label');
  if (label && radarFrames[0]?.times[radarCurrentFrame]) {
    const dt = new Date(radarFrames[0].times[radarCurrentFrame]);
    label.textContent = dt.toLocaleString('th-TH', { hour: '2-digit', minute: '2-digit', day: 'numeric', month: 'short' });
  }

  // แสดง "ฝนไม่ตก" ถ้าทุกโซน 0mm
  const statusEl = document.getElementById('rain-status');
  if (statusEl) {
    if (hasAnyRain) {
      statusEl.style.display = 'none';
    } else {
      statusEl.style.display = 'inline-block';
      statusEl.textContent = '☀️ ไม่มีฝนในขณะนี้';
    }
  }
}

// ปุ่ม toggle เปิด/ปิด radar
function toggleRainRadar() {
  rainEnabled = !rainEnabled;
  const btn = document.getElementById('radar-toggle-btn');
  if (rainEnabled) {
    btn.innerHTML = '🌧️ ฝน (เปิด)';
    btn.style.background = '#dbeafe';
    btn.style.borderColor = '#3b82f6';
    btn.style.color = '#1e40af';
    updateRadarFrame();
  } else {
    btn.innerHTML = '🌧️ ฝน (ปิด)';
    btn.style.background = '#f1f5f9';
    btn.style.borderColor = '#cbd5e1';
    btn.style.color = '#64748b';
    if (rainLayerGroup) { map.removeLayer(rainLayerGroup); rainLayerGroup = null; }
  }
}

