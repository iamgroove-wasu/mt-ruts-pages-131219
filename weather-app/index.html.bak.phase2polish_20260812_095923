  <script>
  (function() {
    const ZONES_META = { khuan_maphrao: '🌾', tha_khae: '🌳', khao_chai_son: '⛰️', ban_mai: '🏘️', ban_khao: '🏘️' };
    async function loadFloodCard() {
      try {
        const res = await fetch('/flood-warning.php?format=summary');
        const data = await res.json();
        const labelEl = document.getElementById('flood-label');
        if (labelEl) {
          labelEl.textContent = data.overall_label || 'ปกติ';
          const s = data.overall_status;
          labelEl.className = 'text-xs font-bold mt-0.5 ' + (s === 'danger' ? 'text-rose-600' : s === 'warning' ? 'text-amber-600' : s === 'watch' ? 'text-amber-600' : 'text-emerald-600');
        }
        const iconEl = document.getElementById('flood-overall');
        if (iconEl) iconEl.textContent = data.overall_icon || '🟢';
        const zones = data.zones || [];
        const pAvg = zones.length ? (zones.reduce((s, z) => s + (z.p_flood || 0), 0) / zones.length) : 0;
        const riskLabel = pAvg >= 0.5 ? 'ระวัง' : pAvg >= 0.3 ? 'เฝ้าระวัง' : 'ปลอดภัย';
        const riskColor = pAvg >= 0.5 ? 'text-rose-700' : pAvg >= 0.3 ? 'text-amber-700' : 'text-emerald-700';
        const pEl = document.getElementById('flood-pavg');
        if (pEl) { pEl.textContent = riskLabel; pEl.className = 'font-bold text-sm mt-0.5 ' + riskColor; }
        const needle = document.getElementById('gauge-needle');
        if (needle) needle.setAttribute('transform', `rotate(${(pAvg * 180) - 90} 70 68)`);
        const grid = document.getElementById('flood-zones');
        if (grid) {
          grid.innerHTML = zones.map(z => {
            const emoji = ZONES_META[z.id] || '📍';
            const p = z.p_flood || 0;
            const status = p >= 0.5 ? 'ระวัง' : p >= 0.3 ? 'เฝ้าระวัง' : 'ปลอดภัย';
            const sColor = p >= 0.5 ? 'text-rose-700' : p >= 0.3 ? 'text-amber-700' : 'text-emerald-700';
            const pct = Math.max(0, Math.min(100, p * 100));
            return `<div class="bg-slate-50 rounded p-2 text-center border border-slate-100 hover:border-blue-300 transition-colors">
              <div class="text-xl">${emoji}</div>
              <div class="text-[10px] text-slate-600 truncate font-medium">${z.name}</div>
              <div class="relative h-1.5 rounded-full mt-1" style="background: linear-gradient(to right, #10b981 0% 30%, #f59e0b 30% 50%, #e11d48 50% 100%);">
                <div class="absolute top-[-2px] w-0.5 h-3 bg-slate-900 rounded" style="left: ${pct}%;"></div>
              </div>
              <div class="text-[10px] font-bold ${sColor} mt-0.5">${status}</div>
            </div>`;
          }).join('');
        }
      } catch (e) { console.error('Flood card load error:', e); }
    }
    loadFloodCard();
    setInterval(loadFloodCard, 5 * 60 * 1000);
  })();
  </script>
