    const r = await fetch(url);
    const d = await r.json();
    const rain24h = (d.hourly?.precipitation || []).slice(0, 24).reduce((s, v) => s + (v || 0), 0);
    const wind = d.current?.wind_speed_10m || 0;
    const tempMax = d.daily?.temperature_2m_max?.[0] || 0;
    // Rain card
    let rName, rEmoji, rBg, rTxt, rActs;
    if (rain24h > 10) { rName = 'ฝนหนัก'; rEmoji = '🌧️'; rBg = 'bg-rose-50 border-rose-300'; rTxt = 'text-rose-700'; rActs = ['งดเก็บเกี่ยว', 'ตรวจท่อระบายน้ำ', 'งดพ่นยา']; }
    else if (rain24h > 2) { rName = 'ฝนปานกลาง'; rEmoji = '🌦️'; rBg = 'bg-amber-50 border-amber-300'; rTxt = 'text-amber-700'; rActs = ['พ่นยาตอนเช้า', 'ระวังดินชะล้าง']; }
    else { rName = 'ฝนน้อย'; rEmoji = '☀️'; rBg = 'bg-blue-50 border-blue-300'; rTxt = 'text-blue-700'; rActs = ['รดน้ำตอนเช้า', 'คลุมดินลดการระเหย']; }
    // Wind card
    let wName, wEmoji, wBg, wTxt, wActs;
    if (wind > 30) { wName = 'ลมแรง'; wEmoji = '💨'; wBg = 'bg-rose-50 border-rose-300'; wTxt = 'text-rose-700'; wActs = ['ยึดโครงเรือน', 'ตรวจต้นไม้ใหญ่']; }
    else if (wind > 15) { wName = 'ลมปานกลาง'; wEmoji = '🌬️'; wBg = 'bg-amber-50 border-amber-300'; wTxt = 'text-amber-700'; wActs = ['ระวังกิ่งหัก']; }
    else { wName = 'ลมอ่อน'; wEmoji = '🍃'; wBg = 'bg-emerald-50 border-emerald-300'; wTxt = 'text-emerald-700'; wActs = ['ทำงานได้ตามปกติ']; }
    // Temp card
    let tName, tEmoji, tBg, tTxt, tActs;
    if (tempMax > 35) { tName = 'ร้อนจัด'; tEmoji = '🥵'; tBg = 'bg-rose-50 border-rose-300'; tTxt = 'text-rose-700'; tActs = ['พ่นน้ำลดอุณหภูมิ', 'งดทำงานกลางวัน']; }
    else if (tempMax > 30) { tName = 'ร้อน'; tEmoji = '☀️'; tBg = 'bg-amber-50 border-amber-300'; tTxt = 'text-amber-700'; tActs = ['ดื่มน้ำบ่อยๆ']; }
    else if (tempMax < 20) { tName = 'เย็น'; tEmoji = '🧥'; tBg = 'bg-blue-50 border-blue-300'; tTxt = 'text-blue-700'; tActs = ['คลุมต้นอ่อน']; }
    else { tName = 'ปกติ'; tEmoji = '🌤️'; tBg = 'bg-emerald-50 border-emerald-300'; tTxt = 'text-emerald-700'; tActs = ['ทำงานได้ตามปกติ']; }
    // Flood card (from existing flood data if loaded)
    let fName = 'ปลอดภัย', fEmoji = '✅', fBg = 'bg-emerald-50 border-emerald-300', fTxt = 'text-emerald-700', fActs = ['ทำงานได้ตามปกติ'];
    // Render
    const render = (emoji, name, txt, bg, data, acts) =>
      `<div class="rounded-lg p-4 border-2 ${bg} text-center">
        <div class="text-3xl mb-1">${emoji}</div>
        <div class="font-bold text-base ${txt}">${name}</div>
        <div class="text-xs text-slate-600 mb-2">${data}</div>
        <div class="text-[11px] text-left space-y-1 mt-2 pt-2 border-t border-slate-200">${acts.map(a => '<div>✓ ' + a + '</div>').join('')}</div>
      </div>`;
    document.getElementById('adv-rain').outerHTML = render(rEmoji, rName, rTxt, rBg, rain24h.toFixed(1) + ' มม. ใน 24 ชม.', rActs);
    document.getElementById('adv-wind').outerHTML = render(wEmoji, wName, wTxt, wBg, wind.toFixed(0) + ' กม./ชม.', wActs);
    document.getElementById('adv-temp').outerHTML = render(tEmoji, tName, tTxt, tBg, 'สูงสุด ' + tempMax.toFixed(0) + '°C', tActs);
    document.getElementById('adv-flood').outerHTML = render(fEmoji, fName, fTxt, fBg, 'ระดับน้ำปกติ', fActs);
    document.getElementById('adv-time').textContent = 'อัปเดต ' + new Date().toLocaleTimeString('th-TH', {hour:'2-digit', minute:'2-digit'});
  } catch(e) { console.error('Advisory load error:', e); }
}
loadAdvisories();
setInterval(loadAdvisories, 600000);
</script>

<script>
// ===== 🎯 Phase 1: Emergency Bar + Hero + 5-Zone Mini + Action Language =====
const ZONE_CROP_NAMES = {
  khuan_maphrao:   { name: 'ควนมะพร้าว', emoji: '🌾', action_ok: 'ข้าว: รดน้ำได้',          action_warn: 'ข้าว: ระวังน้ำขัง' },
  tha_khae:        { name: 'ท่าแค',     emoji: '🌿', action_ok: 'พลู: เก็บใบได้',         action_warn: 'พลู: งดเก็บใบเปียก' },
  khao_chai_son:   { name: 'เขาชัยสน',  emoji: '🍌', action_ok: 'กล้วย: ตัดเครือได้',       action_warn: 'กล้วย: ระวังลมหัก' },
  ban_mai:         { name: 'บ้านใหม่',   emoji: '🥥', action_ok: 'มะพร้าว: เก็บลูกได้',      action_warn: 'มะพร้าว: ระวังน้ำเค็ม' },
  ban_khao:        { name: 'บ้านขาว',   emoji: '🦐', action_ok: 'กุ้ง+พริก: ให้อาหารได้',  action_warn: 'กุ้ง: งดให้อาหารก่อนฝน' }
};

function phase1Level(rainToday, wind, floodP) {
  if (rainToday > 30 || wind > 40 || floodP > 0.7) return 'red';
  if (rainToday > 10 || wind > 25 || floodP > 0.5) return 'orange';
  if (rainToday > 2  || wind > 15 || floodP > 0.3) return 'yellow';
  return 'green';
}

function phase1Actions(rainToday, rainTmrw, codeTmrw) {
  const out = [];
  if (rainToday > 10)        out.push('❌ งดเก็บเกี่ยววันนี้');
  else if (rainToday > 2)    out.push('⚠️ เก็บเกี่ยวเช้ามืด');
  else                       out.push('✅ เก็บเกี่ยวได้ปกติ');
  if (rainTmrw > 10)         out.push('🌧️ พรุ่งนี้: ฝนหนัก เตรียมพร้อม');
  else                       out.push('☀️ พรุ่งนี้: ทำงานกลางแจ้งได้');
  if (codeTmrw >= 95)        out.push('⛈️ ระวังฟ้าผ่า');
  return out;
}

function phase1Emergency(maxRain, maxWind, floodP) {
  if (maxRain > 30 || maxWind > 40 || floodP > 0.7) return { level: 'red',    emoji: '🚨', label: 'อันตราย' };
  if (maxRain > 10 || maxWind > 25 || floodP > 0.5) return { level: 'orange', emoji: '⚠️', label: 'เตือนภัย' };
  if (maxRain > 2  || maxWind > 15 || floodP > 0.3) return { level: 'yellow', emoji: '🟡', label: 'เฝ้าระวัง' };
  return                                                  { level: 'green',  emoji: '✅', label: 'ปลอดภัย' };
}

async function loadPhase1() {
  try {
    const results = await Promise.all(zones.map(async z => {
      try {
        const url = `https://api.open-meteo.com/v1/forecast?latitude=${z.lat}&longitude=${z.lng}&current=temperature_2m,precipitation,weathercode,wind_speed_10m&hourly=precipitation&daily=temperature_2m_max,precipitation_sum,weathercode&timezone=Asia/Bangkok&forecast_days=2`;
        const r = await fetch(url);
        const d = await r.json();
        const c = d.current || {};
        const t0 = d.daily || {};
        return {
          zone: z,
          temp: c.temperature_2m,
          rain: c.precipitation || 0,
          code: c.weathercode || 0,
          wind: c.wind_speed_10m || 0,
          max: t0.temperature_2m_max?.[0],
          min: t0.temperature_2m_min?.[0],
          rainToday: t0.precipitation_sum?.[0] || 0,
          rainTmrw:  t0.precipitation_sum?.[1] || 0,
          codeTmrw:  t0.weathercode?.[1] || 0,
          hourlyRain: (d.hourly?.precipitation || []).slice(0, 12),
          hourlyTime: (d.hourly?.time || []).slice(0, 12)
        };
      } catch (e) { return { zone: z, error: true }; }
    }));

    const maxRain = Math.max(...results.map(r => r.rainToday || 0));
    const maxWind = Math.max(...results.map(r => r.wind || 0));
    const floodP = 0.39; // synced with existing flood card

    // === 1. Emergency Bar ===
    const em = phase1Emergency(maxRain, maxWind, floodP);
    const bar = document.getElementById('emergency-bar');
    if (bar) {
      bar.className = `emergency-bar warning-${em.level}`;
      const lbl = document.getElementById('emergency-label');
      lbl.textContent = `สถานะ: ${em.label}`;
      lbl.className = `font-bold text-sm ${
        em.level === 'green'  ? 'text-emerald-700' :
        em.level === 'yellow' ? 'text-amber-700'   :
        em.level === 'orange' ? 'text-orange-700'  : 'text-rose-800'
      }`;
      document.getElementById('emergency-emoji').textContent = em.emoji;
      document.getElementById('emergency-sub').textContent = `· 5 โซน ${em.level === 'green' ? 'ปลอดภัย' : 'เฝ้าระวัง'} 24 ชม.`;
    }
    const colorCls = em.level === 'green'  ? 'text-emerald-700' :
                     em.level === 'yellow' ? 'text-amber-700'   :
                     em.level === 'orange' ? 'text-orange-700'  : 'text-rose-700';
    const chipsEl = document.getElementById('emergency-chips');
    if (chipsEl) {
      chipsEl.innerHTML = `
        <span class="px-2 py-1 rounded-full bg-white/70 border border-current font-semibold ${colorCls}">🌧️ ฝน ${maxRain.toFixed(1)} มม.</span>
        <span class="px-2 py-1 rounded-full bg-white/70 border border-current font-semibold ${colorCls}">💨 ลม ${maxWind.toFixed(0)} กม./ชม.</span>
        <span class="px-2 py-1 rounded-full bg-white/70 border border-current font-semibold ${colorCls}">🌊 เข็ม P(น้ำท่วม) ${floodP.toFixed(2)}</span>
      `;
    }

    // === 2. Hero Section ===
    const heroZone = results.find(r => r.zone.id === 'khuan_maphrao') || results[0];
    const hero1 = document.getElementById('hero-rain-next');
    const timelineEl = document.getElementById('hero-rain-timeline');
    if (hero1 && timelineEl && heroZone.hourlyRain && heroZone.hourlyRain.length) {
      let nextRain = null;
      for (let i = 0; i < heroZone.hourlyRain.length; i++) {
        if (heroZone.hourlyRain[i] > 0.5) { nextRain = { i, precip: heroZone.hourlyRain[i], time: heroZone.hourlyTime[i] }; break; }
      }
      if (nextRain) {
        const dt = new Date(nextRain.time);
        const timeStr = dt.toLocaleString('th-TH', { hour: '2-digit', minute: '2-digit' });
        hero1.innerHTML = `🌧️ ตก <span class="text-amber-300">${timeStr}</span> · ${nextRain.precip.toFixed(1)} มม.`;
      } else {
        hero1.innerHTML = `☀️ ไม่มีฝนใน 12 ชม.`;
      }
      const maxPrecip = Math.max(...heroZone.hourlyRain, 1);
      timelineEl.innerHTML = heroZone.hourlyRain.map((p, i) => {
        const h = new Date(heroZone.hourlyTime[i]).getHours();
        const height = Math.max((p / maxPrecip) * 28, 2);
        let cls = 'zero';
        if (p > 10) cls = 'veryheavy';
        else if (p > 5) cls = 'heavy';
        else if (p > 1) cls = 'medium';
        else if (p > 0.1) cls = 'light';
        return `<div class="flex flex-col items-center gap-1" style="min-width: 22px;">
          <div class="rain-bar ${cls}" style="height: ${height}px;"></div>
          <div class="text-[9px] opacity-70 font-mono">${h}</div>
        </div>`;
      }).join('');
    }

    const heroActions = document.getElementById('hero-actions');
    if (heroActions) {
      const actions = [];
      if (maxRain > 10) {
        actions.push({ icon: '❌', text: 'งดเก็บเกี่ยววันนี้ (ฝนหนัก)' });
        actions.push({ icon: '🔧', text: 'ตรวจท่อระบายน้ำ' });
      } else if (maxRain > 2) {
        actions.push({ icon: '⚠️', text: 'เก็บเกี่ยวเช้ามืด' });
        actions.push({ icon: '💧', text: 'ระวังดินชะล้าง' });
      } else {
        actions.push({ icon: '✅', text: 'เก็บเกี่ยวได้ตามปกติ' });
        actions.push({ icon: '💧', text: 'รดน้ำตอนเช้า' });
      }
      const maxRainTmrw = Math.max(...results.map(r => r.rainTmrw || 0));
      if (maxRainTmrw > 10) actions.push({ icon: '🌧️', text: 'พรุ่งนี้: ฝนหนัก เตรียมพร้อม' });
      else                   actions.push({ icon: '🌤️', text: 'พรุ่งนี้: ทำงานกลางแจ้งได้' });
      heroActions.innerHTML = actions.slice(0, 3).map(a =>
        `<li class="flex items-start gap-2"><span class="text-base leading-none">${a.icon}</span><span class="opacity-95">${a.text}</span></li>`
      ).join('');
    }

    const timeEl = document.getElementById('hero-time');
    if (timeEl) timeEl.textContent = '⏱ ' + new Date().toLocaleTimeString('th-TH', { hour: '2-digit', minute: '2-digit' });

    // === 3. 5-Zone Mini Status ===
    const miniEl = document.getElementById('zone-mini-status');
    if (miniEl) {
      miniEl.innerHTML = results.map(r => {
        const lvl = phase1Level(r.rainToday || 0, r.wind || 0, floodP);
        const meta = ZONE_CROP_NAMES[r.zone.id];
        const em = { green: '✅', yellow: '🟡', orange: '⚠️', red: '🚨' }[lvl];
        return `<span class="zone-mini-chip ${lvl}" onclick="document.getElementById('zone-forecast-grid').scrollIntoView({behavior:'smooth'})" title="${meta.name} - ${(r.rainToday || 0).toFixed(1)} มม.">
          ${em} ${meta.emoji} ${meta.name} <span class="font-mono">${(r.rainToday || 0).toFixed(1)}</span>มม
        </span>`;
      }).join('');
    }

    // === 4. Enhance per-zone grid with action language ===
    const grid = document.getElementById('zone-forecast-grid');
    if (grid) {
      grid.innerHTML = results.map(r => {
        if (r.error) {
          return `<div class="bg-red-50 p-3 rounded-lg text-xs text-red-600 text-center">⚠️ ${r.zone.name}<br>โหลดไม่สำเร็จ</div>`;
        }
        const emoji = WEATHER_CODES[r.code] || '🌡️';
        const emojiTmrw = WEATHER_CODES[r.codeTmrw] || '🌡️';
        let bg = 'bg-emerald-50', border = 'border-emerald-200', text = 'text-emerald-700';
        if (r.rainToday > 5) { bg = 'bg-rose-50'; border = 'border-rose-200'; text = 'text-rose-700'; }
        else if (r.rainToday > 0) { bg = 'bg-amber-50'; border = 'border-amber-200'; text = 'text-amber-700'; }
        const meta = ZONE_CROP_NAMES[r.zone.id];
        const isWarn = r.rainToday > 5;
        const actionClass = isWarn ? 'warn' : 'ok';
        const actionText = isWarn ? meta.action_warn : meta.action_ok;
        const actions = phase1Actions(r.rainToday, r.rainTmrw, r.codeTmrw);
        return `
          <div class="${bg} border ${border} rounded-lg p-3 hover:shadow-md transition-shadow cursor-pointer" onclick="map.flyTo([${r.zone.lat}, ${r.zone.lng}], 11, {duration:1})">
            <div class="flex items-center justify-between mb-2">
              <div class="text-xs font-semibold navy truncate">${r.zone.emoji} ${r.zone.name}</div>
              <div class="text-2xl">${emoji}</div>
            </div>
            <div class="text-2xl font-bold navy font-mono">${r.temp?.toFixed(1) || '—'}<span class="text-xs text-slate-500">°C</span></div>
            <div class="text-[10px] text-slate-500 mt-1">H ${r.max?.toFixed(0) || '—'}° / L ${r.min?.toFixed(0) || '—'}°</div>
            <div class="text-[10px] ${text} font-semibold mt-1 pt-1 border-t ${border}">
              🌧️ วันนี้ ${r.rainToday?.toFixed(1) || '0.0'} มม.
            </div>
            <div class="text-[10px] text-slate-500 mt-1 flex items-center gap-1">
              ${emojiTmrw} พรุ่งนี้ ${r.rainTmrw?.toFixed(1) || '0.0'} มม.
            </div>
            <div class="zone-action ${actionClass}">
              <span>${isWarn ? '⚠️' : '✅'}</span>
              <span>${actionText}</span>
            </div>
            ${actions.map(a => `<div class="zone-action-sub">${a}</div>`).join('')}
          </div>`;
      }).join('');
      const ztEl = document.getElementById('zone-forecast-time');
      if (ztEl) ztEl.textContent = new Date().toLocaleTimeString('th-TH', { hour: '2-digit', minute: '2-digit' });
    }

  } catch (e) {
    console.error('Phase 1 load failed:', e);
  }
}

loadPhase1();
setInterval(loadPhase1, 10 * 60 * 1000);
</script>

<script>
// ===== 🌊 Phase 2: Marine Weather Visualizations (Wave + Temp + Humidity + Wind) =====
const PHASE2_CENTROID = { lat: 7.62, lng: 100.15 };
const PHASE2_DIR_LABELS = ['เหนือ', 'ตะวันออกเฉียงเหนือ', 'ตะวันออก', 'ตะวันออกเฉียงใต้', 'ใต้', 'ตะวันตกเฉียงใต้', 'ตะวันตก', 'ตะวันตกเฉียงเหนือ'];

function renderWaveGauge(waveH) {
  const v = Math.max(0, Math.min(3, waveH));
  const rot = (v / 3) * 180 - 90;
  const needle = document.getElementById('wave-needle');
  if (needle) needle.setAttribute('transform', `rotate(${rot} 100 100)`);
  const valEl = document.getElementById('wave-value');
  if (valEl) valEl.textContent = v.toFixed(2);
  const actEl = document.getElementById('wave-action');
  if (actEl) {
    if (v >= 2.5) { actEl.className = 'phase2-viz-action danger'; actEl.textContent = '⛔ เรือเล็กงดออก'; }
    else if (v >= 2.0) { actEl.className = 'phase2-viz-action warn'; actEl.textContent = '⚠️ ระวังคลื่นลมแรง'; }
    else if (v >= 1.0) { actEl.className = 'phase2-viz-action warn'; actEl.textContent = '✅ เรือเล็กออกได้'; }
    else { actEl.className = 'phase2-viz-action ok'; actEl.textContent = '✅ ทะเลสงบ'; }
    actEl.style.display = 'inline-flex';
  }
}

function renderThermometer(temp) {
  const v = Math.max(0, Math.min(40, temp));
  const tubeHeight = (v / 40) * 110;
  const tubeEl = document.getElementById('thermo-mercury-tube');
  if (tubeEl) {
    tubeEl.setAttribute('y', 120 - tubeHeight);
    tubeEl.setAttribute('height', tubeHeight);
  }
  let color = '#10b981';
  if (v >= 35) color = '#dc2626';
  else if (v >= 30) color = '#f59e0b';
  else if (v < 20) color = '#93c5fd';
  if (tubeEl) tubeEl.setAttribute('fill', color);
  const bulb = document.getElementById('thermo-mercury-bulb');
  if (bulb) bulb.setAttribute('fill', color);
  const valEl = document.getElementById('temp-value');
  if (valEl) valEl.textContent = v.toFixed(1);
  const actEl = document.getElementById('temp-action');
  if (actEl) {
    if (v >= 35) { actEl.className = 'phase2-viz-action danger'; actEl.textContent = '🥵 ร้อนจัด'; }
    else if (v >= 30) { actEl.className = 'phase2-viz-action warn'; actEl.textContent = '☀️ ร้อน · ดื่มน้ำ'; }
    else if (v < 20) { actEl.className = 'phase2-viz-action warn'; actEl.textContent = '🧥 เย็น · คลุมต้นอ่อน'; }
    else { actEl.className = 'phase2-viz-action ok'; actEl.textContent = '🌤️ ปกติ'; }
    actEl.style.display = 'inline-flex';
  }
}

function renderDropletMeter(humidity) {
  const v = Math.max(0, Math.min(100, humidity));
  const fillHeight = (v / 100) * 110;
  const fillEl = document.getElementById('droplet-fill');
  if (fillEl) {
    fillEl.setAttribute('y', 115 - fillHeight);
    fillEl.setAttribute('height', fillHeight);
  }
  const valEl = document.getElementById('humidity-value');
  if (valEl) valEl.textContent = v.toFixed(0);
  const actEl = document.getElementById('humidity-action');
  if (actEl) {
    if (v >= 90) { actEl.className = 'phase2-viz-action warn'; actEl.textContent = '⚠️ เสี่ยงเชื้อรา'; }
    else if (v >= 70) { actEl.className = 'phase2-viz-action ok'; actEl.textContent = '✅ ชื้นปกติ'; }
    else if (v >= 40) { actEl.className = 'phase2-viz-action ok'; actEl.textContent = '✅ แห้งสบาย'; }
    else { actEl.className = 'phase2-viz-action warn'; actEl.textContent = '⚠️ แห้งมาก'; }
    actEl.style.display = 'inline-flex';
  }
}

function renderWindArrow(windDir, windSpeed) {
  const group = document.getElementById('wind-arrow-group');
  if (group) group.setAttribute('transform', `rotate(${windDir} 60 60)`);
  const speedEl = document.getElementById('wind-speed');
  if (speedEl) speedEl.textContent = windSpeed.toFixed(1);
  const dirIdx = Math.round(windDir / 45) % 8;
  const dirEl = document.getElementById('wind-dir-label');
  if (dirEl) dirEl.textContent = `ทิศ ${PHASE2_DIR_LABELS[dirIdx]}`;
  const actEl = document.getElementById('wind-action');
  if (actEl) {
    if (windSpeed >= 40) { actEl.className = 'phase2-viz-action danger'; actEl.textContent = '⛈️ ลมแรงมาก'; }
    else if (windSpeed >= 25) { actEl.className = 'phase2-viz-action warn'; actEl.textContent = '⚠️ ลมแรง'; }
    else if (windSpeed >= 15) { actEl.className = 'phase2-viz-action warn'; actEl.textContent = '🌬️ ลมปานกลาง'; }
    else { actEl.className = 'phase2-viz-action ok'; actEl.textContent = '🍃 ลมอ่อน'; }
    actEl.style.display = 'inline-flex';
  }
}

async function loadPhase2() {
  try {
    // Marine data (wave)
    const marineUrl = `https://marine-api.open-meteo.com/v1/marine?latitude=${PHASE2_CENTROID.lat}&longitude=${PHASE2_CENTROID.lng}&current=wave_height,wave_direction,wave_period&timezone=Asia/Bangkok`;
    const marineData = await fetch(marineUrl).then(r => r.json()).catch(() => null);
    const waveHeight = marineData?.current?.wave_height || 0;

    // Weather details (humidity + wind direction + wind speed)
    const detailUrl = `https://api.open-meteo.com/v1/forecast?latitude=${PHASE2_CENTROID.lat}&longitude=${PHASE2_CENTROID.lng}&current=relative_humidity_2m,wind_direction_10m,wind_speed_10m&timezone=Asia/Bangkok`;
    const detailData = await fetch(detailUrl).then(r => r.json()).catch(() => null);
    const humidity = detailData?.current?.relative_humidity_2m || 0;
    const windDir = detailData?.current?.wind_direction_10m || 0;
    const windSpeed = detailData?.current?.wind_speed_10m || 0;

    // Aggregate from Phase 1 results (for temp only) — fallback to detail if not ready
    const zoneResults = window.phase1Results || [];
    const temps = zoneResults.map(r => r.temp || 0).filter(t => t > 0);
    const avgTemp = temps.length ? temps.reduce((a, b) => a + b, 0) / temps.length : (detailData?.current?.temperature_2m || 30);

    // Render all 4 visualizations
    renderWaveGauge(waveHeight);
    renderThermometer(avgTemp);
    renderDropletMeter(humidity);
    renderWindArrow(windDir, windSpeed);

    // Update time
    const tEl = document.getElementById('phase2-time');
    if (tEl) tEl.textContent = new Date().toLocaleTimeString('th-TH', { hour: '2-digit', minute: '2-digit' });

  } catch (e) {
    console.error('Phase 2 load failed:', e);
  }
}

loadPhase2();
setInterval(loadPhase2, 10 * 60 * 1000);
</script>

