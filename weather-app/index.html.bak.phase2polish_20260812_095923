  .radar-container { position: relative; height: 280px; border-radius: 12px; overflow: hidden;
    background: radial-gradient(circle at center, #0c1e3e 0%, #050d1f 100%); }
  .radar-grid { position: absolute; inset: 0; opacity: 0.18;
    background-image:
      repeating-conic-gradient(from 0deg, transparent 0deg 8deg, rgba(255,255,255,0.4) 8deg 9deg),
      repeating-radial-gradient(circle at center, transparent 0px, transparent 39px, rgba(255,255,255,0.15) 40px, rgba(255,255,255,0.15) 41px); }
  .radar-sweep { position: absolute; top: 50%; left: 50%; width: 50%; height: 4px;
    background: linear-gradient(90deg, transparent, #10b981);
    transform-origin: 0 50%;
    animation: sweep 4s linear infinite;
    box-shadow: 0 0 20px #10b981; }
  @keyframes sweep { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }
  .radar-blip { position: absolute; background: #fbbf24; border-radius: 50%;
    box-shadow: 0 0 12px #fbbf24; animation: blip 2s ease-in-out infinite; }
  @keyframes blip { 0%, 100% { opacity: 0.3; transform: scale(0.8); } 50% { opacity: 1; transform: scale(1.2); } }
