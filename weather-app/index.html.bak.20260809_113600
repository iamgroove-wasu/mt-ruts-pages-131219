        const data = await res.json();
        const precip6h = (data.hourly.precipitation || []).slice(0, 6).reduce((a,b) => a + (b||0), 0);
        const codeNow = data.hourly.weather_code?.[0] || 0;
        let color, opacity, label;
        if (precip6h >= 10 || codeNow >= 95) { color = '#be123c'; opacity = 0.5; label = 'ฝนหนักมาก/พายุ'; }
        else if (precip6h >= 4 || (codeNow >= 65 && codeNow <= 86)) { color = '#dc2626'; opacity = 0.45; label = 'ฝนหนัก'; }
        else if (precip6h >= 1 || (codeNow >= 51 && codeNow <= 67)) { color = '#f59e0b'; opacity = 0.4; label = 'ฝนปานกลาง'; }
        else if (precip6h > 0) { color = '#10b981'; opacity = 0.35; label = 'ฝนเบา'; }
        else { color = '#94a3b8'; opacity = 0.2; label = 'ไม่มีฝน'; }
        return {z, precip6h, color, opacity, label};
      });
      const results = await Promise.all(promises);
