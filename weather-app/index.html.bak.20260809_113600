  // 🔄 Auto-reload full page every 10 minutes (refresh server-side data: SKA, stations, stats, timestamp)
  let refreshCountdown = 600;
  setInterval(() => {
    refreshCountdown--;
    const indicator = document.getElementById('refresh-indicator');
    if (indicator) {
