      indicator.textContent = `🔄 รีเฟรชใน ${m}:${s.toString().padStart(2, '0')}`;
      indicator.classList.toggle('opacity-50', refreshCountdown < 60);
    }
    if (refreshCountdown <= 0) location.reload();
  }, 1000);
