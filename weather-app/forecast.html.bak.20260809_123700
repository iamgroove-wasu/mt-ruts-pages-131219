<script>
function forecastApp() {
  return {
    loading: false,
    activeZone: 'khuan_maphrao',
    source: '🌦️ WeatherNext 2',
    forecast: null,
    alerts: [],
    hourlyData: [],
    windDir: 225,
    windSpeed: 0,
    windDirLabel: 'ตะวันตกเฉียงใต้',
    windClass: {label: 'ลมสงบ', bg: '#dcfce7', color: '#16a34a'},
    lastUpdated: '--:--',
    zones: [
      {id:'khuan_maphrao', name:'ควนมะพร้าว', emoji:'🌾', color:'#1e40af', lat:7.6175, lng:100.0680, province:'พัทลุง', coord:'7.62°N, 100.07°E'},
      {id:'tha_khae', name:'ท่าแค', emoji:'🌿', color:'#b45309', lat:7.5750, lng:100.0900, province:'พัทลุง', coord:'7.58°N, 100.09°E'},
      {id:'khao_chai_son', name:'เขาชัยสน', emoji:'🍌', color:'#a16207', lat:7.4613, lng:100.1337, province:'พัทลุง', coord:'7.46°N, 100.13°E'},
      {id:'ban_mai', name:'บ้านใหม่', emoji:'🥥', color:'#be123c', lat:7.7750, lng:100.3450, province:'สงขลา', coord:'7.78°N, 100.35°E'},
      {id:'ban_khao', name:'บ้านขาว', emoji:'🦐', color:'#9333ea', lat:7.7850, lng:100.3050, province:'สงขลา', coord:'7.79°N, 100.31°E'}
    ],
    get currentZone() {
      return this.zones.find(z => z.id === this.activeZone) || this.zones[0];
    },
    
    async init() {
      // Watch forecast.daily and activeZone — re-render SVG chart dots when data changes
      // (Alpine <template x-for> doesn't work inside SVG namespace, so we use imperative DOM rendering)
      this.$watch('forecast.daily', () => {
        this.$nextTick(() => this.renderChartDots());
      });
      this.$watch('activeZone', () => {
        this.$nextTick(() => this.renderChartDots());
      });
      await this.selectZone(this.activeZone);
      setTimeout(() => this.initMap(), 100);
      // Auto-refresh every 5 minutes (300,000 ms)
      setInterval(() => {
        console.log('🔄 Auto-refresh forecast...');
        this.selectZone(this.activeZone);
      }, 300000);
    },

    renderChartDots() {
      const daily = this.forecast?.daily || [];
      const SVG_NS = 'http://www.w3.org/2000/svg';
      if (!daily.length) return;

      // Helper: create SVG element with attributes + optional text
      const svgEl = (tag, attrs, text) => {
        const el = document.createElementNS(SVG_NS, tag);
        for (const [k, v] of Object.entries(attrs)) el.setAttribute(k, v);
        if (text !== undefined) el.textContent = text;
        return el;
      };

      // Define each group's elements
      const groups = [
        {
          id: 'chart-max-dots',
          build: (d, i) => svgEl('circle', {
            cx: 40 + i * 103, cy: this.chartY(d.temp_max),
            r: 4, fill: '#f97316', stroke: 'white', 'stroke-width': 2
          })
        },
        {
          id: 'chart-min-dots',
          build: (d, i) => svgEl('circle', {
            cx: 40 + i * 103, cy: this.chartY(d.temp_min),
            r: 4, fill: '#3b82f6', stroke: 'white', 'stroke-width': 2
          })
        },
        {
          id: 'chart-max-labels',
          build: (d, i) => svgEl('text', {
            x: 40 + i * 103, y: this.chartY(d.temp_max) - 10,
            'text-anchor': 'middle', 'font-size': 11, 'font-weight': 700, fill: '#f97316'
          }, Math.round(d.temp_max) + '°')
        },
        {
          id: 'chart-min-labels',
          build: (d, i) => svgEl('text', {
            x: 40 + i * 103, y: this.chartY(d.temp_min) + 18,
            'text-anchor': 'middle', 'font-size': 11, 'font-weight': 700, fill: '#3b82f6'
          }, Math.round(d.temp_min) + '°')
        },
        {
          id: 'chart-day-labels',
          build: (d, i) => svgEl('text', {
            x: 40 + i * 103, y: 238,
            'text-anchor': 'middle', 'font-size': 10, 'font-weight': 600, fill: '#475569'
          }, this.getDayShort(d.date))
        }
      ];

      groups.forEach(({ id, build }) => {
        const g = document.getElementById(id);
        if (!g) return;
        // Clear existing children
        while (g.firstChild) g.removeChild(g.firstChild);
        // Append fresh elements
        daily.forEach((d, i) => g.appendChild(build(d, i)));
      });
    },
    
    async selectZone(zoneId) {
      this.activeZone = zoneId;
      this.loading = true;
      this.alerts = [];
      try {
        // Fetch daily forecast (absolute path — weather-next.php is at workspace root, not in /weather-app/)
        const res = await fetch(`/weather-next.php?zone=${zoneId}`);
        const data = await res.json();
        if (data.daily) {
          this.forecast = data;
          this.source = '✓ ' + (data.source || 'Open-Meteo WeatherNext 2');
          this.computeAlerts();
          this.lastUpdated = new Date().toLocaleTimeString('th-TH', {hour:'2-digit', minute:'2-digit'});
        } else {
          this.forecast = null;
          this.source = '⚠ API ไม่มีข้อมูล';
        }
        // Fetch hourly forecast from Open-Meteo (separate API)
        const zone = this.zones.find(z => z.id === zoneId);
        if (zone) {
          await this.fetchHourly(zone.lat, zone.lng);
          this.computeWind();
        }
      } catch (e) {
        console.error('Forecast fetch failed:', e);
        this.forecast = null;
        this.source = '⚠ โหลดไม่สำเร็จ';
      }
      this.loading = false;
      this.updateMap();
    },
    
    async fetchHourly(lat, lng) {
      try {
        const url = `https://api.open-meteo.com/v1/forecast?latitude=${lat}&longitude=${lng}&hourly=temperature_2m,precipitation,wind_speed_10m,wind_direction_10m,weather_code&forecast_days=7&timezone=Asia%2FBangkok`;
        const res = await fetch(url);
        const data = await res.json();
        if (data.hourly) {
          const h = data.hourly;
          this.hourlyData = h.time.slice(0, 168).map((t, i) => {
            const d = new Date(t);
            const hour = d.getHours();
            const isDaytime = hour >= 6 && hour < 18;
            const prevDate = i > 0 ? new Date(h.time[i-1]).getDate() : null;
            const dayLabel = (i === 0 || prevDate !== d.getDate()) ? ['อา','จ','อ','พ','พฤ','ศ','ส'][d.getDay()] + ' ' + d.getDate() : '';
            return {
              time: t,
              day_label: dayLabel,
              hour_short: hour.toString().padStart(2,'0') + ':00',
              temp: h.temperature_2m[i],
              precip: h.precipitation[i] || 0,
              wind: h.wind_speed_10m[i],
              icon: this.getHourlyIcon(h.weather_code[i], hour)
            };
          });
        }
      } catch (e) {
        console.error('Hourly fetch failed:', e);
        this.hourlyData = [];
      }
    },
    
    getHourlyIcon(code, hour) {
      if (hour < 6 || hour >= 19) return '🌙';
      if (code === 0) return '☀️';
      if (code <= 3) return '⛅';
      if (code <= 48) return '🌫️';
      if (code <= 67) return '🌧️';
      if (code <= 77) return '❄️';
      if (code <= 82) return '🌦️';
      if (code <= 86) return '🌧️';
      if (code <= 99) return '⛈️';
      return '⛅';
    },
    
    computeWind() {
      if (!this.forecast?.daily) return;
      // Calculate avg wind direction + speed from daily data
      const days = this.forecast.daily;
      const avgSpeed = days.reduce((s,d) => s + (d.wind_max || 0), 0) / days.length;
      // Mock wind direction based on lat (Songkhla Lake = SW monsoon = ~225°)
      const zone = this.zones.find(z => z.id === this.activeZone);
      let dir = 225; // SW default
      if (zone?.id === 'khao_chai_son') dir = 90; // E (mountain area)
      else if (zone?.id === 'ban_mai' || zone?.id === 'ban_khao') dir = 135; // SE (coastal)
      else if (zone?.id === 'tha_khae') dir = 270; // W
      this.windSpeed = avgSpeed;
      this.windDir = dir;
      const dirs = ['เหนือ','ตะวันออกเฉียงเหนือ','ตะวันออก','ตะวันออกเฉียงใต้','ใต้','ตะวันตกเฉียงใต้','ตะวันตก','ตะวันตกเฉียงเหนือ'];
      const idx = Math.round(dir / 45) % 8;
      this.windDirLabel = dirs[idx];
      
      // Wind class
      if (this.windSpeed < 5) { this.windClass = {label: 'ลมสงบ', bg: '#dcfce7', color: '#16a34a'}; }
      else if (this.windSpeed < 15) { this.windClass = {label: 'ลมเบา', bg: '#dbeafe', color: '#2563eb'}; }
      else if (this.windSpeed < 25) { this.windClass = {label: 'ลมปานกลาง', bg: '#fef3c7', color: '#d97706'}; }
      else { this.windClass = {label: 'ลมแรง', bg: '#fee2e2', color: '#dc2626'}; }
    },
    
    computeAlerts() {
      if (!this.forecast?.daily) return;
      this.alerts = [];
      this.forecast.daily.slice(0, 3).forEach((day, idx) => {
        const dayLabel = idx === 0 ? 'วันนี้' : `+${idx} วัน`;
        if (day.precip_mm > 20) {
          this.alerts.push({id: `rain-${idx}`, icon:'⛈️', color:'#dc2626', bg:'#fee2e2',
            title:'ฝนตกหนัก', day: dayLabel,
            detail: `ฝน ${day.precip_mm.toFixed(1)} mm — ระวังน้ำท่วมแปลง ระบายน้ำล่วงหน้า`});
        } else if (day.precip_mm > 5) {
          this.alerts.push({id: `rain-${idx}`, icon:'🌧️', color:'#d97706', bg:'#fef3c7',
            title:'ฝนปานกลาง', day: dayLabel,
            detail: `ฝน ${day.precip_mm.toFixed(1)} mm — เฝ้าระวัง`});
        }
        if (day.temp_max > 35) {
          this.alerts.push({id: `hot-${idx}`, icon:'☀️', color:'#d97706', bg:'#fef3c7',
            title:'อากาศร้อนจัด', day: dayLabel,
            detail: `อุณหภูมิ ${day.temp_max.toFixed(1)}°C — รดน้ำเช้า-เย็น คลุมดิน`});
        }
        if (day.wind_max > 35) {
          this.alerts.push({id: `wind-${idx}`, icon:'💨', color:'#0ea5e9', bg:'#e0f2fe',
            title:'ลมแรง', day: dayLabel,
            detail: `ลม ${day.wind_max.toFixed(1)} km/h — ค้ำต้นไม้ ตรวจโครงสร้างเรือนเพาะชำ`});
        }
      });
    },
    
    mapInstance: null,
    markers: {},
    
    initMap() {
      if (this.mapInstance) return;
      this.mapInstance = L.map('mini-map', {zoomControl: true, attributionControl: true}).setView([7.6, 100.18], 9);
      L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {attribution: '© OSM', maxZoom: 18}).addTo(this.mapInstance);
      
      this.zones.forEach(z => {
        const icon = L.divIcon({
          className: '',
          html: `<div class="map-marker ${z.id === this.activeZone ? 'active' : ''}" data-zone="${z.id}" style="color:${z.color}">${z.emoji}</div>`,
          iconSize: [36, 36],
          iconAnchor: [18, 18]
        });
        const marker = L.marker([z.lat, z.lng], {icon: icon}).addTo(this.mapInstance);
        marker.on('click', () => this.selectZone(z.id));
        this.markers[z.id] = marker;
      });
    },
    
    updateMap() {
      if (!this.mapInstance) return;
      const z = this.currentZone;
      this.mapInstance.flyTo([z.lat, z.lng], 10, {duration: 0.8});
      // Update marker styles
      Object.entries(this.markers).forEach(([id, marker]) => {
        const isActive = id === this.activeZone;
        const zData = this.zones.find(zz => zz.id === id);
        const newIcon = L.divIcon({
          className: '',
          html: `<div class="map-marker ${isActive ? 'active' : ''}" style="color:${zData.color}">${zData.emoji}</div>`,
          iconSize: [36, 36],
          iconAnchor: [18, 18]
        });
        marker.setIcon(newIcon);
      });
    },
    
    getWeatherIcon(day) {
      if (!day) return '⛅';
      if (day.precip_mm > 20) return '⛈️';
      if (day.precip_mm > 5) return '🌧️';
      if (day.precip_mm > 0.5) return '🌦️';
      if (day.temp_max > 34) return '☀️';
      return '⛅';
    },
    
    // Chart helpers
    chartY(temp) {
      // Map temp 15-35°C to Y 220-20 (inverted)
      const minT = 15, maxT = 35;
      return 20 + (maxT - temp) * (200 / (maxT - minT));
    },
    get chartMaxLine() {
      if (!this.forecast?.daily) return '';
      return this.forecast.daily.map((d, i) => `${40 + i * 103},${this.chartY(d.temp_max)}`).join(' ');
    },
    get chartMinLine() {
      if (!this.forecast?.daily) return '';
      return this.forecast.daily.map((d, i) => `${40 + i * 103},${this.chartY(d.temp_min)}`).join(' ');
    },
    get chartMaxArea() {
      if (!this.forecast?.daily) return '';
      const points = this.chartMaxLine + ' ' + this.chartMinLine.split(' ').reverse().join(' ');
      return points;
    },
    getDayShort(dateStr) {
      const d = new Date(dateStr);
      return ['อา','จ','อ','พ','พฤ','ศ','ส'][d.getDay()];
    },
    
    getDayName(dateStr) {
      const d = new Date(dateStr);
      const days = ['อา','จ','อ','พ','พฤ','ศ','ส'];
      return days[d.getDay()];
    },
    
    formatDate(dateStr) {
      const d = new Date(dateStr);
      return d.getDate() + ' ' + ['ม.ค.','ก.พ.','มี.ค.','เม.ย.','พ.ค.','มิ.ย.','ก.ค.','ส.ค.','ก.ย.','ต.ค.','พ.ย.','ธ.ค.'][d.getMonth()];
    }
  };
}
</script>
</body>
</html>
